<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shelf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shelf_bg">

    <!-- Widgets Scroll Container -->
    <com.discoveryscreen.ui.ShelfScrollView
        android:id="@+id/shelf_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="always"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <com.discoveryscreen.widget.WidgetGridLayout
            android:id="@+id/shelf_widgets_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Placeholder card shown when shelf is empty -->
            <LinearLayout
                android:id="@+id/shelf_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="iOS-Style Widget Shelf"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Place your weather, clock, music, battery and other regular Android widgets here!"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_placeholder_add"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/pill_button"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_add_widget"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

        </com.discoveryscreen.widget.WidgetGridLayout>
    </com.discoveryscreen.ui.ShelfScrollView>
</FrameLayout>
